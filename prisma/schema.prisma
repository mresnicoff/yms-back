// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "rhel-openssl-3.0.x" es el target que
  // necesitan las funciones serverless de Vercel (Amazon Linux) en runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationType {
  LOAD
  UNLOAD
}
enum DocumentOwnerType {
  DRIVER
  TRUCK
}

enum AssignmentMode {
AUTO
MANUAL
}

enum DockStatus {
  FREE
  OCCUPIED
  OUT_OF_SERVICE
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  WAITING_DOCK
  IN_OPERATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DockOperationStatus {
  ASSIGNED
  IN_PROGRESS
  FINISHED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CheckoutMode {
  DISPATCH
  CLIENT_PALLETS
}
model Document {
  id String @id @default(uuid())

  documentTypeId String
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  ownerType DocumentOwnerType

  driverId String?
  driver Driver? @relation(fields: [driverId], references: [id])

  truckId String?
  truck Truck? @relation(fields: [truckId], references: [id])

  expirationDate DateTime?

  fileUrl String

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([truckId])
  @@index([expirationDate])
}

model RequiredDocument {
  id String @id @default(uuid())

  documentTypeId String
  documentType DocumentType @relation(fields: [documentTypeId], references: [id])

  operationType OperationType?

  ownerType DocumentOwnerType

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Warehouse {
  id String @id @default(uuid())

  code String @unique
  name String

  address String?

  active Boolean @default(true)

  // Elige qué formulario de Check-Out se muestra: el de siempre (hoja de
  // ruta + precintos) o el del flujo Fátima/Infolog (cliente + pallets).
  checkoutMode CheckoutMode @default(DISPATCH)

  // Última vez que se sincronizaron viajes de Infolog para este depósito.
  // Se usa para no re-consultar Snowflake si ya se hizo hace poco.
  infologLastSyncedAt DateTime?

  dockGroups   DockGroup[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DockGroup {
  id String @id @default(uuid())

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  assignmentMode AssignmentMode @default(AUTO)
  code String @unique
  name String

  description String?

  active Boolean @default(true)

  docks        Dock[]
  appointments Appointment[]
  schedules    DockGroupSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
}

model DockGroupSchedule {
  id String @id @default(uuid())

  dockGroupId String
  dockGroup   DockGroup @relation(fields: [dockGroupId], references: [id])

  // 0 = domingo ... 6 = sábado (mismo criterio que Date.getDay() en JS),
  // siempre interpretado en hora de Buenos Aires.
  weekday Int

  // Horario de atención en formato "HH:MM", hora de Buenos Aires.
  // Nulos cuando closed = true (el dock group no atiende ese día).
  startTime String?
  endTime   String?

  closed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dockGroupId, weekday])
  @@index([dockGroupId])
}

model Dock {
  id String @id @default(uuid())

  code String @unique

  description String?

  groupId String
  group   DockGroup @relation(fields: [groupId], references: [id])

  status DockStatus @default(FREE)

  // Nullable: con un grupo de docks compartido para carga y descarga, un
  // dock ya no está atado a un único tipo de operación. Se conserva el
  // valor histórico en los docks que ya lo tenían asignado.
  operationType OperationType?

  active Boolean @default(true)

  schedules  DockSchedule[]
  operations DockOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([status])
}

model DockSchedule {
  id String @id @default(uuid())

  dockId String
  dock   Dock   @relation(fields: [dockId], references: [id])

  weekday Int

  startTime String
  endTime   String

  active Boolean @default(true)

  @@index([dockId])
  @@index([weekday])
}

model VehicleType {
  id String @id @default(uuid())

  name String @unique

  loadingMinutes   Int
  unloadingMinutes Int

  appointments Appointment[]
  trucks       Truck[]
}

model Supplier {
  id String @id @default(uuid())

  name String

  taxId String @unique

  email String?

  appointments Appointment[]

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Truck {
  id String @id @default(uuid())

  plate String @unique

  vehicleTypeId String
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id])

  active Boolean @default(true)

  checkIns CheckIn[]
  // Check-Ins donde este Truck participó como semi-acoplado (no como
  // tractor). Un mismo Truck puede ser tractor en un viaje y semi en otro.
  semiCheckIns CheckIn[] @relation("CheckInSemiTruck")
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model DocumentType {
  id String @id @default(uuid())

  code String @unique

  name String

  description String?

  active Boolean @default(true)

  documents Document[]
  requiredDocuments RequiredDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Appointment {
  id String @id @default(uuid())

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Opcional porque los viajes que llegan desde Infolog no traen tipo de
  // vehículo: se completa en el Check-In junto con el chofer y las patentes.
  vehicleTypeId String?
  vehicleType   VehicleType? @relation(fields: [vehicleTypeId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  dockGroupId String
  dockGroup   DockGroup @relation(fields: [dockGroupId], references: [id])

  operationType OperationType

  startTime DateTime
  endTime   DateTime

  status AppointmentStatus @default(SCHEDULED)

  // ID de viaje que manda Infolog (NUMTOU). Único y opcional: solo lo
  // tienen los turnos que se crearon a partir de un viaje de Infolog, y
  // evita importar el mismo viaje dos veces. Un turno con este campo
  // cargado es, por definición, un turno de origen Infolog.
  externalTripId String? @unique

  checkIn CheckIn?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
  @@index([status])
  @@index([warehouseId])
  @@index([dockGroupId])
  @@index([dockGroupId, startTime])
}

model CheckIn {
  id String @id @default(uuid())

  appointmentId String @unique
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  truckId String
  truck Truck @relation(fields: [truckId], references: [id])

  // Semi-acoplado de este viaje puntual (flujo Fátima/Infolog). Va acá y
  // no en el camión porque un mismo tractor puede llevar semis distintos
  // en cada viaje. Se modela como un Truck más, así hereda el control de
  // documentación obligatoria igual que cualquier camión.
  semiTruckId String?
  semiTruck Truck? @relation("CheckInSemiTruck", fields: [semiTruckId], references: [id])

  driverId String?
  driver Driver? @relation(fields: [driverId], references: [id])

  arrivalTime DateTime

  createdById String?
  createdBy User? @relation("UserCheckIns", fields: [createdById], references: [id])

  dockOperation DockOperation?
  atraco        Atraco?

  createdAt DateTime @default(now())

  @@index([truckId])
  @@index([semiTruckId])
  @@index([driverId])
  @@index([arrivalTime])
}

model Atraco {
  id String @id @default(uuid())

  checkInId String @unique
  checkIn   CheckIn @relation(fields: [checkInId], references: [id])

  // Cuántas cuñas se colocaron (0 = no se colocó ninguna).
  cunasColocadas Int

  llavesOk Boolean

  // Hora real en la que ocurrió el Atraco. Se precarga con la hora actual
  // en el frontend, pero es editable: si el operador lo carga más tarde
  // (se la "comieron"), puede corregirla a la hora real.
  horaAtraco DateTime @default(now())

  // Se carga acá una sola vez y se reutiliza de solo lectura en el
  // Check-Out (checkoutMode = CLIENT_PALLETS), no se vuelve a pedir.
  clienteFinal String

  receptor String
  auditor  String
  cargador String

  createdById String?
  createdBy   User? @relation("UserAtracos", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

model DockOperation {
  id String @id @default(uuid())

  dockId String
  dock Dock @relation(fields: [dockId], references: [id])

  checkInId String @unique
  checkIn CheckIn @relation(fields: [checkInId], references: [id])

  assignedById String?
  assignedBy User? @relation("UserDockAssignments", fields: [assignedById], references: [id])

  startedAt DateTime

  finishedAt DateTime?

  status DockOperationStatus

  dispatch Dispatch?

  createdAt DateTime @default(now())

  @@index([dockId])
  @@index([status])
  @@index([startedAt])
}

model User {
  id String @id @default(uuid())

  firstName String
  lastName  String

  email String @unique

  passwordHash String

  status UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  checkInsCreated CheckIn[] @relation("UserCheckIns")

  dockAssignments DockOperation[] @relation("UserDockAssignments")

  atracosCreated Atraco[] @relation("UserAtracos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([roleId])
  @@index([supplierId])
}

model Role {
  id String @id @default(uuid())

  code String @unique
  name String

  users User[]
}

model Permission {
  id String @id @default(uuid())

  code String @unique
  name String
}
model Dispatch {
  id String @id @default(uuid())

  dockOperationId String @unique

  dockOperation DockOperation @relation(fields: [dockOperationId], references: [id])

  // Opcional porque el flujo Fátima/Infolog (checkoutMode = CLIENT_PALLETS)
  // no pide hoja de ruta: en ese modo se completa `pallets` en su lugar.
  routeSheetNumber String?

  sealNumbers String[]

  // Cantidad de pallets, alternativo a routeSheetNumber/sealNumbers cuando
  // checkoutMode = CLIENT_PALLETS. El cliente de ese checkout ya quedó
  // cargado en Atraco, no se duplica acá.
  pallets Int?

  checkedOutAt DateTime

  createdAt DateTime @default(now())
}
model Driver {
  id String @id @default(uuid())

  firstName String

  lastName String?

  phone String

  licenseNumber String?

  active Boolean @default(true)

  checkIns CheckIn[]
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}
