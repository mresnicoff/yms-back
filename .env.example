# Cadena de conexión a la base de datos Postgres (Neon).
# Usá la connection string "pooled" de Neon (host con "-pooler") para runtime.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Secreto usado para firmar los JWT de sesión. Generá uno propio y fuerte,
# por ejemplo con: openssl rand -base64 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Duración del token de sesión.
JWT_EXPIRES_IN="8h"

# URL del frontend desplegado, para habilitar CORS en producción.
# Admite varios orígenes separados por coma (útil para preview deployments).
FRONTEND_URL="https://yms-web.vercel.app"

# Puerto solo para desarrollo local (Vercel lo ignora).
PORT=3000

# Vercel Blob — storage de objetos para los archivos que suben los usuarios
# (documentos de conductores/camiones). Reemplaza al disco local (que no
# persiste en funciones serverless). Se crea en el dashboard de Vercel:
# Project -> Storage -> Create Database -> Blob. Vercel inyecta esta
# variable automáticamente en producción/preview al conectar el store al
# proyecto; para desarrollo local, copiá el token desde ahí.
BLOB_READ_WRITE_TOKEN=""

# WhatsApp Cloud API (Meta) — usado para notificar asignación de dock al
# conductor mediante una plantilla de utilidad aprobada. Reemplaza al bot
# anterior basado en whatsapp-web.js/Puppeteer (incompatible con Vercel).
# Token permanente de un system user del WABA, con permiso whatsapp_business_messaging.
WHATSAPP_TOKEN=""
# ID del número de teléfono emisor dentro del WABA (no es el número en sí).
WHATSAPP_PHONE_NUMBER_ID=""
# Nombre de la plantilla de utilidad aprobada para este mensaje.
WHATSAPP_TEMPLATE_DOCK="asignacion_dock"
# Código de idioma con el que se aprobó la plantilla.
WHATSAPP_TEMPLATE_LANG="es_AR"
