# Cadena de conexión a la base de datos Postgres (Neon).
# Usá la connection string "pooled" de Neon (host con "-pooler") para runtime.
DATABASE_URL="postgresql://usuario:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Secreto usado para firmar los JWT de sesión. Generá uno propio y fuerte,
# por ejemplo con: openssl rand -base64 32
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Duración del token de sesión.
JWT_EXPIRES_IN="8h"

# URL del frontend desplegado, para habilitar CORS en producción.
# Admite varios orígenes separados por coma (útil para preview deployments).
FRONTEND_URL="https://yms-web.vercel.app"

# Puerto solo para desarrollo local (Vercel lo ignora).
PORT=3000
